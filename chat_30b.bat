@echo off
chcp 65001 >nul
title موديل 30B على المعالج - بدون كارت شاشة
setlocal

set LLAMA=F:\tools\llamacpp\llama-cli.exe
set MODEL=F:/lmstudio-models/moe/Qwen3-30B-A3B-IQ2_M.gguf
set PROMPT=%*

if "%PROMPT%"=="" set PROMPT=اكتب فقرة قصيرة عن أهمية التغليف الجيد للمطاعم. /no_think

echo ==================================================
echo   موديل: Qwen3-30B-A3B (30 مليار معلومة)
echo   الجهاز: المعالج فقط - بدون كارت شاشة
echo   السرعة المتوقعة: ~20 كلمة/ثانية
echo ==================================================
echo.
echo السؤال: %PROMPT%
echo.
echo (التحميل بياخد شوية أول مرة...)
echo --------------------------------------------------

rem  -ngl 0     : مفيش كارت شاشة
rem  -c 2048    : سياق صغير (الافتراضي 40960 بيحتاج رام كتير)
rem  -nr        : من غير إعادة ترتيب الأوزان (بتطلب 14 جيجا رام!)
rem  -st        : دورة واحدة وينتهي
rem  --no-warmup: من غير تسخين
rem  -t 8       : 8 خيوط

"%LLAMA%" -m "%MODEL%" -ngl 0 -t 8 -c 2048 -nr -st --no-warmup -n 400 -p "%PROMPT%"

echo.
echo ==================================================
echo   خلص.
echo ==================================================
pause
